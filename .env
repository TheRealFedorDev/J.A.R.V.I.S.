# ====== Подсистема курсора ======

# Управлять ли настоящей мышью
POINTER_ENABLED=True

# Сглаживание: one_euro (рекомендуется) | none | ema | kalman
POINTER_SMOOTHING=one_euro

# One Euro: сила фильтра в покое (меньше = плавнее, но «липче»; от 0.3 до 1.0)
POINTER_ONE_EURO_MIN_CUTOFF=0.6

# One Euro: реакция на скорость (выше = меньше отставание и «липкость» в центре; 0.15–0.5)
POINTER_ONE_EURO_BETA=0.3

# Сила EMA-сглаживания (0..1)
POINTER_EMA_ALPHA=0.35

# Чувствительность (0.5 — вдвое медленнее, 1.0 — полный диапазон экрана)
POINTER_SENSITIVITY=1.0

# Мёртвая зона на сглаженной позиции (px) — убирает «дребезг» без квантования
POINTER_DEAD_ZONE=2.0

# Краткая пропажа лица/моргание дольше этого (сек) — сброс фильтра
POINTER_DROPOUT=0.4

# Потолок перемещения курсора за кадр (px) — гасит «выбросы» модели (телепорты)
POINTER_MAX_MOVE=600.0

# Не выходить за границы экрана
POINTER_CLAMP=True

# ====== Подсистема «воздушной мыши» (рука) ======

# Включать ли руку-мышь (палец в камере ведёт курсор, щипок — клик)
HAND_ENABLED=True

# Ручной путь к hand_landmarker.task (пусто — кэш ~/.cache/eyetrax/mediapipe)
HAND_LANDMARKER_PATH=

# Зеркалить X (как трекпад/превью): True — вправо/влево как на экране
HAND_MIRROR_X=True

# Усиление движения палец→курсор (1.6 — комфортно для локтя на опоре)
HAND_SENSITIVITY=1.6

# Пороги щипка (доля от размера ладони): ниже какого — нажато, выше — отпущено
HAND_PINCH_CLOSE=0.35
HAND_PINCH_OPEN=0.55

# Сглаживание приращений (0..1): выше = плавнее, но «лить»
HAND_EMA=0.40

# Мёртвая зона и потолок скорости (px/кадр) для руки
HAND_DEAD_ZONE=1.5
HAND_MAX_MOVE=1400.0

# Сек до возврата к управлению взглядом после исчезновения руки
HAND_DROPOUT=0.8

# ====== Оверлей PyQt6 ======

# Точка взгляда на весь экран
OVERLAY_GAZE_CURSOR=False

# Цвет точки взгляда (HEX)
OVERLAY_CURSOR_COLOR=#00e5ff

# Радиус точки взгляда (px)
OVERLAY_CURSOR_SIZE=22

# Мини-панель предпросмотра камеры
OVERLAY_CAMERA_PANEL=True

# Размер панели
OVERLAY_PANEL_WIDTH=340
OVERLAY_PANEL_HEIGHT=240

# Позиция панели: top-left | top-right | bottom-left | bottom-right
OVERLAY_PANEL_POSITION=top-left

# Прозрачность панели (0..1)
OVERLAY_PANEL_OPACITY=0.88

# ====== Голос: STT ======

# Движок: faster-whisper (base) | vosk
VOICE_ASR=faster-whisper
# medium на CPU (float32) давал ~28 c на 2.7 c речи -> base+int8 в разы быстрее
WHISPER_MODEL=base
WHISPER_LANGUAGE=ru
# int8 обязателен на CPU: без него ctranslate2 откатывается на float32
WHISPER_COMPUTE_TYPE=int8
WHISPER_DEVICE=cpu

# Голосовой агент: legacy | pipecat (STT→LLM→TTS с barge-in)
VOICE_AGENT=pipecat
# interim-подписи гоняют тот же Whisper на том же CPU -> реже, чтобы не тормозить финал
VOICE_PARTIAL_SECONDS=1.5
# окно аудио для одного partial и суммарный бюджет на фразу: без них interim
# перетранскрибирует всю фразу заново каждые 1.5 c и выедает все ядра CPU
VOICE_PARTIAL_MAX_SECONDS=12
VOICE_PARTIAL_WORK_BUDGET=24
# 1.8 c не хватало на холодный запрос (DNS+TLS ~2.3 c) -> пустой ответ по погоде
WEB_SEARCH_TIMEOUT=3.0

# LLM (Ollama OpenAI-compatible API)
LLM_MODEL=llama3.2:3b
LLM_BASE_URL=http://localhost:11434/v1
LLM_MAX_TOKENS=220

# Быстрый веб-поиск (погода/факты)
BERTA_CITY=Москва

# ====== Общее ======

JARVIS_LOG_LEVEL=INFO