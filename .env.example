# ====== Подсистема «воздушная мышь» (рука) ======

# Включать ли руку-мышь (палец в камере ведёт курсор, щипок — клик)
HAND_ENABLED=True

# Ручной путь к hand_landmarker.task (пусто — кэш ~/.cache/eyetrax/mediapipe)
HAND_LANDMARKER_PATH=

# Зеркалить X (как трекпад/превью): True — вправо/влево как на экране
HAND_MIRROR_X=True

# Усиление движения палец→курсор (1.6 — комфортно для локтя на опоре)
HAND_SENSITIVITY=1.6

# Пороги щипка (доля от размера ладони): ниже какого — нажато, выше — отпущено
HAND_PINCH_CLOSE=0.35
HAND_PINCH_OPEN=0.55

# Сглаживание приращений (0..1): выше = плавнее, но «лить»
HAND_EMA=0.40

# Мёртвая зона и потолок скорости (px/кадр) для руки
HAND_DEAD_ZONE=1.5
HAND_MAX_MOVE=1400.0

# Сек до возврата к управлению взглядом после исчезновения руки
HAND_DROPOUT=0.8

# ====== Подсистема голосовых команд (vosk, оффлайн) ======

# Включать ли голосовое управление
VOICE_ENABLED=True

# Путь к модели vosk (по умолчанию models/vosk/vosk-model-small-ru-0.22)
VOICE_MODEL_PATH=models/vosk/vosk-model-small-ru-0.22

# Индекс микрофона sounddevice (пусто — системный микрофон по умолчанию)
VOICE_DEVICE=

# Команды: «клик», «двойной», «право», «скролл вниз/вверх», «включи/выключи», «калибровка»

# ====== Оверлей PyQt6 ======

# Мини-панель предпросмотра камеры
OVERLAY_CAMERA_PANEL=True

# Размер панели
OVERLAY_PANEL_WIDTH=340
OVERLAY_PANEL_HEIGHT=240

# Позиция панели: top-left | top-right | bottom-left | bottom-right
OVERLAY_PANEL_POSITION=top-left

# Прозрачность панели (0..1)
OVERLAY_PANEL_OPACITY=0.88

# ====== Общее ======

JARVIS_LOG_LEVEL=INFO