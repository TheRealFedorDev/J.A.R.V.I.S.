# ====== Подсистема «воздушная мышь» (рука) ======

# Включать ли руку-мышь (палец в камере ведёт курсор, щипок — клик)
HAND_ENABLED=True

# Ручной путь к hand_landmarker.task (пусто — кэш ~/.cache/eyetrax/mediapipe)
HAND_LANDMARKER_PATH=

# Зеркалить X (как трекпад/превью): True — вправо/влево как на экране
HAND_MIRROR_X=True

# Усиление движения палец→курсор (1.6 — комфортно для локтя на опоре)
HAND_SENSITIVITY=1.6

# Пороги щипка (доля от размера ладони): ниже какого — нажато, выше — отпущено
HAND_PINCH_CLOSE=0.35
HAND_PINCH_OPEN=0.55

# Сглаживание приращений (0..1): выше = плавнее, но «лить»
HAND_EMA=0.40

# Мёртвая зона и потолок скорости (px/кадр) для руки
HAND_DEAD_ZONE=1.5
HAND_MAX_MOVE=1400.0

# Сек до возврата к управлению взглядом после исчезновения руки
HAND_DROPOUT=0.8

# ====== Подсистема голосовых команд (faster-whisper / vosk) ======

# Включать ли голосовое управление
VOICE_ENABLED=True

# Голосовой агент: legacy (быстрый STT-конвейер) | pipecat | livekit (LiveKit Agents, barge-in)
VOICE_AGENT=livekit

# Движок STT: faster-whisper (по умолчанию) | vosk
VOICE_ASR=faster-whisper

# Модель whisper (kэш HuggingFace; medium ≈ 1.5 ГБ, large-v3 ≈ 3 ГБ)
WHISPER_MODEL=base
WHISPER_DEVICE=cpu
# int8 обязателен на CPU: без него ctranslate2 откатывается на float32 (в разы медленнее)
WHISPER_COMPUTE_TYPE=int8
WHISPER_LANGUAGE=ru

# Стриминг: порог VAD, сек тишины до финала, интервал partial
VOICE_VAD_THRESHOLD=0.012
VOICE_SILENCE_END=0.55
VOICE_PARTIAL_SECONDS=0.85

# Фоллбэк vosk: путь к модели
VOICE_MODEL_PATH=models/vosk/vosk-model-small-ru-0.22

# Индекс микрофона sounddevice (пусто — системный микрофон по умолчанию)
VOICE_DEVICE=

# Сек тишины, после которого silero VAD считает фразу законченной (LiveKit)
VOICE_MIN_SILENCE=0.6

# Команды: «клик», «двойной», «правый», «скролл вниз/вверх», «включи/выключи», «калибровка»

# ====== Локальный voice API для LiveKit (STT/TTS через OpenAI-совместимый shim) ======

# Хост/порт локального voice API (поднимается автоматически при VOICE_AGENT=livekit)
LOCAL_VOICE_HOST=127.0.0.1
LOCAL_VOICE_PORT=8077
# Базовый URL OpenAI-совместимого API (STT + TTS)
LOCAL_VOICE_URL=http://127.0.0.1:8077/v1

# ====== LLM (livekit-агент / web-роутер) ======
LLM_MODEL=llama3.2:3b
LLM_BASE_URL=http://localhost:11434/v1
# Таймаут LLM-запроса, сек (холодный старт Ollama + whisper тянет время)
LLM_TIMEOUT=60
# Таймаут стриминга ответа, сек. Плагин LiveKit по умолчанию рвёт поток на 10 c,
# а на CPU один только prefill диалога к 4-му вопросу подходит к этому рубежу
LLM_STREAM_TIMEOUT=60
# Лимит длины ГОЛОСОВОГО ответа в токенах. На CPU 3B-модель даёт ~6.5 ток/с
# (0.16 с на токен), поэтому 64 токена ≈ 2-3 фразы ≈ 10 c, а без лимита
# модель может уйти в монолог на 2-3 минуты. Ollama не понимает
# max_completion_tokens — лимит уходит в max_tokens.
VOICE_LLM_MAX_TOKENS=64
# Температура голосового LLM. 0 = строгий детерминированный ответ: убирает
# код-миксинг (английские слова в русских фразах) и неожиданные отступления,
# которые на 3B-модели ломали ответ. Повышать только осознанно: 0.6 заметно
# размывало формулировки. Поднимать выше 0.7 голосовому ассистенту не стоит.
VOICE_LLM_TEMPERATURE=0.0
# Максимум токенов голосового ответа (меньше = быстрее старт TTS)
LLM_MAX_TOKENS=220
# Системный промпт Berta (livekit-агент и legacy)
# BERTA_SYSTEM_PROMPT=

# Дать ли агенту инструмент web_search (LLM сам решает, когда звать; 1=вкл, 0=выкл)
VOICE_WEB_SEARCH=1

# ====== Быстрый веб-поиск (погода/факты, VOICE_WEB_SEARCH=1) ======
# Общий таймаут сети всех источников, сек (DDG + Wikipedia + open-meteo параллельно)
WEB_SEARCH_TIMEOUT=1.8
# Город по умолчанию для «какая погода?»
BERTA_CITY=Москва

# ====== Оверлей PyQt6 ======

# Мини-панель предпросмотра камеры
OVERLAY_CAMERA_PANEL=True

# Размер панели
OVERLAY_PANEL_WIDTH=340
OVERLAY_PANEL_HEIGHT=240

# Позиция панели: top-left | top-right | bottom-left | bottom-right
OVERLAY_PANEL_POSITION=top-left

# Прозрачность панели (0..1)
OVERLAY_PANEL_OPACITY=0.88

# ====== Общее ======

JARVIS_LOG_LEVEL=INFO